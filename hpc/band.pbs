#!/bin/bash
#PBS -N gc_band
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=08:00:00
#PBS -J 1-5040
#PBS -o /rds/general/user/tw2825/ephemeral/hpc_ying_run/logs/
#PBS -e /rds/general/user/tw2825/ephemeral/hpc_ying_run/logs/

# Ying 60/90 denoised band sweep -- 5040-task array. Runs entirely off ephemeral
# (home is full): output, logs, MATLAB prefs and temp all live on ephemeral; the
# runner reads its .m dependencies from home/hpc_ying_run/code (reads need no quota).

module load tools/prod
module load MATLAB/2024b

# keep MATLAB off the full home directory
export MATLAB_PREFDIR=/rds/general/user/tw2825/ephemeral/matlab_prefs
export TMPDIR=/rds/general/user/tw2825/ephemeral/tmp
mkdir -p "$MATLAB_PREFDIR" "$TMPDIR"

cd /rds/general/user/tw2825/ephemeral/hpc_ying_run/code
IDX=${PBS_ARRAY_INDEX:-$IDX}      # array mode uses PBS_ARRAY_INDEX; else -v IDX=n
echo "task $IDX on $(hostname) at $(date)"
matlab -nodisplay -nosplash -batch "hpc_run_band($IDX)"
echo "done task $IDX exit=$?"
