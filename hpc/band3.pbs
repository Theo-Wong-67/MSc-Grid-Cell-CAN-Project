#!/bin/bash
#---------------------------------------------------------------------------
# band3.pbs -- alpha x R synaptic-damage sweep (hpc_run_band.m)
#
#   Grid: alpha 0:0.02:1 (51) x R 0:2:90 (46) x 8 seeds = 18768 tasks
#   Output: $EPHEMERAL/hpc_ying_run/output_band3
#
# NOTE: -J is deliberately NOT set here. Pass it on the command line so the
#       same script serves both the timing test and the full array.
#
#   TIMING (single task, no array):
#       qsub -v IDX=361  band3.pbs      # alpha=0,   R=90, seed=1  -- max damage
#       qsub -v IDX=9377 band3.pbs      # alpha=0.5, R=44, seed=1  -- mid grid
#
#   FULL RUN (after setting walltime below from the timing result):
#       qsub -J 1-10000     band3.pbs
#       qsub -J 10001-18768 band3.pbs
#
#   Check the array cap first:  qmgr -c "print server" | grep -i max_array
#---------------------------------------------------------------------------
#PBS -N band3
#PBS -l select=1:ncpus=1:mem=8gb
#PBS -l walltime=04:00:00
#PBS -o /rds/general/user/tw2825/home/hpc_ying_run/logs/
#PBS -e /rds/general/user/tw2825/home/hpc_ying_run/logs/

set -u

CODE=/rds/general/user/tw2825/home/hpc_ying_run/code
cd "$CODE" || { echo "FATAL: cannot cd to $CODE"; exit 1; }

# Exact module name varies by cluster -- run `module avail matlab` and edit if this fails.
# Must be R2015a or newer (imgaussfilt, used by the Voronoi seeding).
module load matlab

echo "=== host=$(hostname)  start=$(date)  code=$CODE"
module list 2>&1 | sed 's/^/    /'

# -singleCompThread: we asked PBS for 1 core, so stop MATLAB grabbing more.
# -batch needs R2019a+. On older MATLAB use instead:
#     matlab -nodisplay -nosplash -r "hpc_run_band; exit"
if [ -n "${IDX:-}" ]; then
    echo "=== single task IDX=$IDX"
    matlab -singleCompThread -batch "hpc_run_band($IDX)"
else
    echo "=== array task PBS_ARRAY_INDEX=$PBS_ARRAY_INDEX"
    matlab -singleCompThread -batch "hpc_run_band"
fi
RC=$?

echo "=== end=$(date)  exit=$RC"
exit $RC
