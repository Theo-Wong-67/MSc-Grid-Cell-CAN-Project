#!/bin/bash
#PBS -N gc_noise
#PBS -l select=1:ncpus=1:mem=16gb
#PBS -l walltime=08:00:00
#PBS -J 1-500
#PBS -o /rds/general/user/tw2825/ephemeral/hpc_ying_run/logs/
#PBS -e /rds/general/user/tw2825/ephemeral/hpc_ying_run/logs/

# 1-D afferent velocity-noise sweep on a HEALTHY network (alpha=1, R=0).
# 10 sigma levels x 50 seeds = 500 tasks. Nagaraj & Narayanan noise model:
# one independent Gaussian draw per neuron per step, sigma = per-component SD in m/s.
# Home is full, so output, logs, MATLAB prefs and temp all live on ephemeral;
# the runner reads its .m dependencies from home/hpc_ying_run/code.

module load tools/prod
module load MATLAB/2024b

export MATLAB_PREFDIR=/rds/general/user/tw2825/ephemeral/matlab_prefs
export TMPDIR=/rds/general/user/tw2825/ephemeral/tmp
mkdir -p "$MATLAB_PREFDIR" "$TMPDIR"

cd /rds/general/user/tw2825/ephemeral/hpc_ying_run/code
IDX=${PBS_ARRAY_INDEX:-$IDX}
echo "task $IDX on $(hostname) at $(date)"
matlab -nodisplay -nosplash -batch "hpc_run_noise($IDX)"
echo "done task $IDX exit=$?"
